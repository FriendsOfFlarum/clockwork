{
    "name": "fof/clockwork",
    "description": "Debug your Flarum forum with Clockwork",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^1.0.2",
        "itsgoingd/clockwork": "5.1.5"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/clockwork/issues",
        "source": "https://github.com/FriendsOfFlarum/clockwork"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\Clockwork\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "1.x": "1.x-dev"
        },
        "flarum-extension": {
            "title": "FoF Clockwork",
            "category": "feature",
            "icon": {
                "name": "fas fa-terminal",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "*"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis"
    }
}
